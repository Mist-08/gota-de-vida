    <!-- Welcome -->
    <string name="bienvenida_subtitulo">When a hospital in La Laguna needs your blood type, we let you know. Only you, and only if you can donate.</string>
    <string name="bienvenida_punto1_titulo">Alerts only if you\'re a match</string>
    <string name="bienvenida_punto1_texto">No chain messages: only emergencies you can help with.</string>
    <string name="bienvenida_punto2_titulo">Book your visit in one message</string>
    <string name="bienvenida_punto2_texto">In the app or on WhatsApp with Gota, your assistant.</string>
    <string name="bienvenida_punto3_titulo">Your location stays private</string>
    <string name="bienvenida_punto3_texto">Hospitals only see how far away you are.</string>
    <string name="bienvenida_consentimiento">I accept the privacy notice and the use of my health data to alert me about emergencies.</string>
