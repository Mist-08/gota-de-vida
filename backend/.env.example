# Copia este archivo como .env en esta carpeta (no se sube al repositorio).
# El backend lo lee solo al arrancar en local. En Render estas variables van en Environment.

PORT=8080

# --- Fase 1 ---
# Atlas: Connect → Drivers → copia la cadena y pon tu usuario y contraseña.
# Para probar sin internet puedes usar un MongoDB local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gotadevida

# Mínimo 32 caracteres. Cada integrante puede usar el suyo en local.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto-de-32-o-mas

# Cuenta de administrador que se crea al arrancar si no existe.
ADMIN_EMAIL=admin@gotadevida.mx
ADMIN_PASSWORD=cambia-esta-contrasena

# Carga 3 hospitales de demostración si la colección está vacía (true/false).
CARGAR_DATOS_DEMO=true

# Opcional: ID de cliente web de OAuth (Google Cloud Console) para "Continuar con Google".
GOOGLE_CLIENT_ID=

# --- Fase 3: urgencias ---
# URL AMQP de CloudAMQP (plan Little Lemur). Vacía = cola en memoria (sirve para desarrollo).
RABBITMQ_URL=
# Cuenta de servicio de Firebase (JSON completo o en base64). Vacía = los avisos solo se registran en el log.
FIREBASE_CREDENCIALES_JSON=
# Minutos entre oleadas de avisos de una urgencia (para la demo se puede bajar a 1).
MINUTOS_ENTRE_OLEADAS=15

# --- Fase 5 (cada integrante usa su propia llave de Google AI Studio en desarrollo) ---
GEMINI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
