        {
          "name": "Registrar donador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registro"
              ]
            },
            "description": "Crea la cuenta y el perfil vacío. El correo cambia en cada corrida para no chocar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mariana Rodríguez\",\n  \"email\": \"{{emailDonador}}\",\n  \"password\": \"{{passwordDonador}}\",\n  \"telefono\": \"871 123 4567\",\n  \"aceptaAvisoPrivacidad\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailDonador\", `mariana.${Date.now()}@correo.mx`);",
                  "pm.collectionVariables.set(\"passwordDonador\", \"contrasena-segura\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Rol DONADOR\", () => pm.expect(r.usuario.rol).to.eql(\"DONADOR\"));",
                  "pm.test(\"Trae tokens\", () => { pm.expect(r.tokens.tokenAcceso).to.be.a(\"string\"); pm.expect(r.tokens.tokenRefresco).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"tokenDonador\", r.tokens.tokenAcceso);",
                  "pm.collectionVariables.set(\"refrescoDonador\", r.tokens.tokenRefresco);"
                ]
              }
            }
          ]
        },
